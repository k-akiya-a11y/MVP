# 値は .env.local に設定してください。このファイルには実際の値を書かないでください。
# freee / Google のユーザートークンは環境変数ではなく Supabase Vault に暗号化して保存します。

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー側のみで使用。クライアントに渡さない
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API ---
ANTHROPIC_API_KEY=
# モデルとプロンプトの版はコードの定数（src/lib/ai/version.ts）で固定する。環境変数では切り替えない

# --- freee（OAuth 2.0 アプリ） ---
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
FREEE_REDIRECT_URI=http://localhost:3000/api/auth/freee/callback

# --- Google（Workspace 内部アプリ） ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# ログインを許可するドメイン（結乃社の Google Workspace ドメイン）
ALLOWED_LOGIN_DOMAIN=

# --- Vercel Cron ---
CRON_SECRET=
